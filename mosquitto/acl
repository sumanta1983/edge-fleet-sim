# Topic layout: tenants/{tenant}/sites/{site}/devices/{device}/{kind}
#
# Each device is pinned to its OWN full topic path, including tenant and
# site. The ingestor takes tenant/site/device identity from the topic, so
# this ACL is what stops a device from posing as another device or tenant.
# (A "+" wildcard pattern like tenants/+/.../devices/%u/events would let a
# device publish under any tenant's prefix - too loose.)

# Cloud side: the ingestor reads everything devices send up, re-sends
# desired config to devices that fall behind (reconciliation), and sends
# release commands as a rollout moves from the canary to the rest.
user ingestor
topic read  tenants/+/sites/+/devices/+/events
topic read  tenants/+/sites/+/devices/+/state
topic read  tenants/+/sites/+/devices/+/ack
topic write tenants/+/sites/+/devices/+/config
topic write tenants/+/sites/+/devices/+/release

# The API pushes desired config when an operator changes it, and the
# canary's release command when a rollout starts (or clears it on halt).
user api
topic write tenants/+/sites/+/devices/+/config
topic write tenants/+/sites/+/devices/+/release

# Tenant A, site A1
user edge-a1-01
topic write tenants/tenant-a/sites/site-a1/devices/edge-a1-01/events
topic write tenants/tenant-a/sites/site-a1/devices/edge-a1-01/state
topic write tenants/tenant-a/sites/site-a1/devices/edge-a1-01/ack
topic read  tenants/tenant-a/sites/site-a1/devices/edge-a1-01/config
topic read  tenants/tenant-a/sites/site-a1/devices/edge-a1-01/release

